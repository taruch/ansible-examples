# Inventory for the MongoDB sharded cluster example.
#
# mongo_servers  - members of the single shard replica set (mongod_replica_set_name
#                  in group_vars/all/vars.yml)
# mongoc_servers - members of the config server replica set (CSRS); use 1 for
#                  dev/test, an odd number >= 3 for production
# mongos_servers - stateless query routers that clients connect to
#
# mongo1-3 intentionally run more than one MongoDB process (a shard member,
# a config server, and/or mongos) to demonstrate the minimum recommended
# production topology described in the README. The standard MongoDB port
# conventions (27017/27018/27019, set in group_vars/all/vars.yml) keep the
# colocated processes on the same host from conflicting with each other.

[mongo_servers]
mongo1
mongo2
mongo3
mongo4

[mongoc_servers]
mongo1
mongo2
mongo3

[mongos_servers]
mongo1
mongo2
