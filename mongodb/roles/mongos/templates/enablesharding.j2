// chunkSize is no longer a mongos startup option; it's set via config.settings.
db.getSiblingDB("config").settings.updateOne(
  { _id: "chunksize" },
  { $set: { value: {{ mongos_chunk_size }} } },
  { upsert: true }
);

sh.enableSharding("{{ mongo_test_database }}");
sh.shardCollection("{{ mongo_test_database }}.{{ mongo_test_collection }}", { number: 1 });

